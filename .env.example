APP_ENV=production
APP_PORT=8080

# postgres://user:password@host:5432/dbname?sslmode=disable
DATABASE_URL=

# Backend session tokens (openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRY=24h
SESSION_COOKIE_NAME=vpn_admin_session

# AES-256 key for encrypting access-key secrets at rest (openssl rand -base64 32)
SECRET_ENCRYPTION_KEY=

# Google OAuth client ID (must match the frontend's AUTH_GOOGLE_ID) - used
# to verify the aud claim on Google ID tokens. The client SECRET stays on
# the frontend only; the backend never needs it.
GOOGLE_CLIENT_ID=

VPN_DOMAIN=vpn.thestrm.space
API_DOMAIN=api.vpn.thestrm.space

# Comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=https://admin.thestrm.space,http://localhost:3000

RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# Outline server Management API, e.g. https://203.0.113.5:41287/aBcDeFgH123
OUTLINE_API_URL=
# SHA-256 fingerprint of the Outline management API's self-signed cert
OUTLINE_API_CERT_SHA256=

POSTGRES_DB=vpn_manager
POSTGRES_USER=vpn_manager
POSTGRES_PASSWORD=
