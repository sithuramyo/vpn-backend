# Example Caddy config for the backend + VPN data plane on the DigitalOcean
# VPS. The frontend is NOT on this box - it's deployed to Vercel
# separately (see ../../vpn-frontend/README.md) and its domain
# (admin.thestrm.space) is a CNAME managed by Vercel, not this Caddy.
#
# Caddy terminates TLS for the two hostnames below; it never proxies raw
# Shadowsocks - only plain HTTP (the API) and WebSocket upgrades that the
# Outline server itself decodes into Shadowsocks.

api.vpn.thestrm.space {
	reverse_proxy 127.0.0.1:8080
}

vpn.thestrm.space {
	# Each access key gets its own random path (see
	# access_keys.websocket_path / websocket_udp_path) so the WebSocket
	# route is unguessable without a valid key. Adjust the upstream to
	# wherever the Outline server's WebSocket listener is bound.
	@websocket {
		header Connection *Upgrade*
		header Upgrade    websocket
	}
	reverse_proxy @websocket 127.0.0.1:443 {
		header_up Connection {http.request.header.Connection}
		header_up Upgrade {http.request.header.Upgrade}
	}

	respond 404
}
